# 首次使用：将本文件复制为项目根目录的 .env，然后填写自己的 API Key。
# .env 仅保存在本机；不要提交、分享或把真实 Key 填回本示例文件。
# 修改后完全退出客户端并重新启动。系统中已有的同名环境变量优先于 .env。

# 模型服务的 API 基础地址；当前使用 OpenAI 兼容的 Chat Completions 协议。
# 通常以 /v1 结尾，不要填写网页聊天地址，也不要追加 /chat/completions。
# 远程服务必须使用 HTTPS；仅 localhost / 127.0.0.1 / [::1] 允许 HTTP。
AGENT_BASE_URL=https://api.moonshot.cn/v1

# 模型 ID 示例；必须是上述服务中你的账户实际可调用、支持流式工具调用的模型。
# 更换服务商时，地址、模型 ID 与 Key 必须配套，兼容性需要实际验证。
AGENT_MODEL=kimi-k3

# 必填：填写你在模型服务商处创建的 API Key；此处故意留空。
AGENT_API_KEY=

# 可选：模型上下文容量与模型允许的输出能力上限，单位 Token。
# 留空使用 src/config.ts 中的默认值；不再额外夹到旧上下文/输出上限。
# 当前 K3 两项默认均为 1048576；它们不是每次请求实际申请的输出量。
# 上下文至少 8192、输出至少 256，均须安全整数；容量由你根据模型服务确认。
# 上下文须大于普通/摘要中较大的输出预留加安全余量，否则启动报错。
# 这些是请求/上下文参数，与下面的每轮累计预算不同。
AGENT_CONTEXT_WINDOW=
AGENT_MAX_OUTPUT_TOKENS=

# 可选：普通回答与压缩摘要各自的输出预算；留空各自默认 32768。
# 两者独立于模型能力，不随 AGENT_MAX_OUTPUT_TOKENS 改变。
# 各自不得超过 AGENT_MAX_OUTPUT_TOKENS 的生效值。
AGENT_RUN_OUTPUT_TOKENS=
AGENT_COMPACTION_OUTPUT_TOKENS=
# K3 始终思考；low / high / max。主对话默认 high，摘要默认 low。
AGENT_REASONING_EFFORT=
AGENT_COMPACTION_REASONING_EFFORT=
# 默认 8192；不用于替代供应商 token 计数。
AGENT_SAFETY_TOKENS=
# 默认 0.9；大于 0 且小于 1。默认压缩水位为 906854 Token。
# 压缩水位从上下文、输出预留、安全余量与此比例计算，不另外配置。
AGENT_COMPRESSION_RATIO=
# 自动压缩保留的最近历史估算目标，默认 65536；小窗口还受近期历史比例约束。
AGENT_COMPACTION_RECENT_TOKENS=

# 单次模型请求与整轮运行均不设置总时限。
# 首段有效内容等待默认 300000 毫秒；长输入需要额外的预处理时间。
AGENT_REQUEST_FIRST_CONTENT_TIMEOUT_MS=
# 收到有效内容后，连续无内容时限默认 90000 毫秒。
# 非空推理、正文、工具参数增量刷新；空事件不刷新。
# 两项允许范围均为 1000–3600000。旧 AGENT_REQUEST_TIMEOUT_MS 已废弃。
AGENT_REQUEST_IDLE_TIMEOUT_MS=
# 对话列表连续没有模型正文时，程序补充真实运行状态的间隔，默认 15000 毫秒。
# 这是可调整的界面反馈节奏，不是运行时限或模型预算；允许 1–2147483647 的整数。
AGENT_PROGRESS_SILENCE_MS=
AGENT_TOOL_TIMEOUT_MS=
# 工具返回 JSON 的最大字节数；与下面读取正文的字节数不是同一限制。
AGENT_TOOL_RESULT_MAX_BYTES=

# 可选的每轮运行预算；未设置或留空表示不设该项上限。
# 需要限制时填写正安全整数；0、负数和小数无效。修改后重启客户端。
# 累计 Token 用量不等于单次上下文窗口，也不代表供应商账户余额。
AGENT_RUN_TOKEN_LIMIT=
AGENT_RUN_MAX_MODEL_CALLS=
AGENT_RUN_MAX_TOOL_CALLS=
# 可选累计工具失败上限；默认不限。已修正的错误不应累计到固定次数后强制停止。
AGENT_RUN_MAX_TOOL_FAILURES=
# 相同调用连续失败的保护阈值，默认 2；再次原样调用会停止。
AGENT_MAX_REPEATED_FAILURES=

# 工作区策略（字节和条数分别配置）；留空使用 src/config.ts 的默认值。
XUWU_IMPORT_MAX_FILE_BYTES=
XUWU_IMPORT_MAX_TOTAL_BYTES=
# 默认 1000；数量限制与字节限制独立，当前实现会全目录扫描和计算 hash。
XUWU_IMPORT_MAX_FILES=
XUWU_TEXT_MAX_BYTES=
XUWU_READ_DEFAULT_LINES=
XUWU_READ_MAX_LINES=
XUWU_READ_MAX_BYTES=
XUWU_PAGE_DEFAULT_LIMIT=
XUWU_PAGE_MAX_LIMIT=

# 可选：本地会话、副本、备份与 trace 的存放位置；源码启动默认在项目的 .my-agent/。
# 留空即可。自定义时建议使用仓库外的绝对路径，例如 D:/FileBuddyData。
# 自定义目录不会因为本项目的 .gitignore 而自动得到保护；不要将它提交到其他仓库。
# 启动器日志仍写入项目的 .my-agent/，不随此项移动。
XUWU_DATA_DIR=
